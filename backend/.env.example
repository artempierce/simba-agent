# Copy to backend/.env (git ignores it) and fill in. Never commit a real key: the repo is public.

# 1 = free fake model (no key needed, no cost). Remove or set to 0 to use real Claude.
SIMBA_FAKE_LLM=1

# Needed only when SIMBA_FAKE_LLM is not 1.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: enables the read-only Tavily web_search tool. Leave blank to disable web search.
TAVILY_API_KEY=
